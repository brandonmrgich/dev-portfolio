---
// ---
// label: index page
// role: The whole site. One page, ordered so a recruiter's first screen answers
//   "who is this and what do they do" before asking them to scroll.
// invariants: Section order is Hero → Skills → Work → Repos → Experience → Credentials.
//   Skills sits high on purpose: it is the section people scan for first.
// last-touched: 2026-08-10
// ---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Skills from '../components/Skills.astro'
import Featured from '../components/Featured.astro'
import Repos from '../components/Repos.astro'
import Experience from '../components/Experience.astro'
import Credentials from '../components/Credentials.astro'
import SectionNav from '../components/SectionNav.astro'
import Principles from '../components/Principles.astro'
import Writing from '../components/Writing.astro'
import SupportCTA from '../components/SupportCTA.astro'
import resume from '../data/resume.json'

const title = `${resume.basics.name} — ${resume.basics.label}`
---

<Base title={title} description={resume.basics.headline}>
  <SectionNav />
  <Hero />
  <Skills />
  <Featured />
  <Writing />
  <Repos />
  <Experience />
  <Principles />
  <Credentials />
  <SupportCTA />
</Base>
