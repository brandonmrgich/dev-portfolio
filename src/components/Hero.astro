---
// ---
// label: Hero
// role: Above-the-fold identity block — name, current role, headline, contact links.
// invariants: Every value comes from resume.json basics; nothing is hardcoded here.
//   The current role is the most recently started entry with no endDate — picked by
//   startDate rather than array position, so reordering or appending to resume.json
//   cannot silently promote the wrong job into the hero.
// last-touched: 2026-08-10
// ---
import { existsSync } from 'node:fs'
import { join } from 'node:path'
import resume from '../data/resume.json'

const { basics } = resume
const current = resume.work
  .filter((w) => !w.endDate)
  .sort((a, b) => b.startDate.localeCompare(a.startDate))[0]

// scripts/fetch-avatar.mjs is allowed to fail without failing the build, so the photo
// is genuinely optional. Checking the file rather than assuming it means a skipped
// fetch renders a page with no photo instead of a broken image icon.
//
// Resolved from cwd, NOT from import.meta.url: Astro's SSR build rewrites components
// into bundled chunks, so import.meta.url points at a generated path and every
// relative lookup from it silently misses. Astro always builds from the project root.
const hasAvatar = existsSync(join(process.cwd(), 'public/avatar.jpg'))
---

<header class="hero">
  <div class="wrap">
    <div class="identity">
      {
        hasAvatar && (
          <img
            class="avatar"
            src="/avatar.jpg"
            width="96"
            height="96"
            decoding="async"
            alt={`${basics.name}, profile photo`}
          />
        )
      }
      <div>
        <p class="mono kicker">{basics.location.city}, {basics.location.region}</p>
        <h1>{basics.name}</h1>
      </div>
    </div>

    {
      current && (
        <p class="role">
          {current.position} · <span>{current.name}</span>
          {current.client && <span class="client"> at {current.client}</span>}
        </p>
      )
    }

    <p class="headline">{basics.headline}</p>

    <ul class="links">
      {
        basics.profiles.map((p) => (
          <li>
            <a href={p.url} rel="me">
              {p.network} <span class="handle">{p.username}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .hero {
    padding: 4.5rem 0 3.25rem;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.1rem;
  }

  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    flex: none;
    object-fit: cover;
    border: 1px solid var(--border-strong);
    background: var(--bg-inset);
  }

  @media (max-width: 32rem) {
    .avatar {
      width: 68px;
      height: 68px;
    }
  }

  .kicker {
    margin: 0 0 0.4rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .role {
    font-size: 1.0625rem;
    color: var(--text);
    margin-bottom: 1.1rem;
    max-width: var(--measure);
  }

  .role span {
    color: var(--accent);
  }

  .role .client {
    color: var(--text-muted);
  }

  .headline {
    font-size: 1.0625rem;
    color: var(--text-muted);
    max-width: 60ch;
    margin-bottom: 1.75rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .links a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-decoration: none;
    color: var(--text);
  }

  .links a:hover .handle {
    color: var(--link);
  }

  .links .handle {
    color: var(--text-faint);
  }
</style>
