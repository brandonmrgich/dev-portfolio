---
// ---
// label: SectionRail
// role: Fixed timeline-style rail on the right edge marking which section is in view.
// invariants:
//   - This is the ONLY client-side JavaScript on the site. It is a deliberate island,
//     not a default — see the note in README. Everything it does is progressive
//     enhancement: with JS off the rail is still a working list of anchor links, just
//     without the active marker.
//   - `sections` must stay in sync with the section ids rendered by index.astro. A
//     stale id is skipped silently rather than throwing (getElementById -> null is
//     filtered), so a typo degrades to a dead link, never a broken page.
// gotchas:
//   - Active section is chosen by scroll position against a line near the top of the
//     viewport, NOT by an IntersectionObserver band. Both a visibility threshold and a
//     mid-viewport band leave dead zones: a threshold can never fire for a section
//     taller than the screen, and a band at 45% is unreachable both by a short section
//     after an anchor click and by the final section at the end of the document.
//   - The last section needs the explicit at-bottom case. Without it, Education is
//     permanently unhighlightable because the page runs out of scroll first.
//   - Hidden under 64rem: there is no gutter to put it in, and overlaying content on a
//     phone to show navigation for a page this short is not a trade worth making.
// last-touched: 2026-08-10
// ---
const sections = [
  { id: 'skills', label: 'Skills' },
  { id: 'work', label: 'Selected Work' },
  { id: 'open-source', label: 'Repositories' },
  { id: 'experience', label: 'Experience' },
  { id: 'education', label: 'Education' },
]
---

<nav class="rail" aria-label="Page sections">
  <ul>
    {
      sections.map((s) => (
        <li>
          <a href={`#${s.id}`} data-rail-link={s.id}>
            <span class="dot" aria-hidden="true" />
            <span class="label">{s.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const links = new Map(
    [...document.querySelectorAll('[data-rail-link]')].map((a) => [
      (a as HTMLElement).dataset.railLink,
      a,
    ]),
  )

  const targets = [...links.keys()]
    .map((id) => document.getElementById(id as string))
    .filter((el): el is HTMLElement => el !== null)

  let active: string | null = null

  function setActive(id: string) {
    if (id === active) return
    if (active) links.get(active)?.removeAttribute('aria-current')
    links.get(id)?.setAttribute('aria-current', 'true')
    active = id
  }

  // The active section is the last one whose top has passed a line near the top of the
  // viewport. Deliberately NOT an IntersectionObserver band: a band placed mid-viewport
  // has two dead zones. A section shorter than the band's offset never reaches it after
  // an anchor click (which lands the section top at y=0), and the final section can
  // never reach it at all, because the document stops scrolling first.
  const LINE = 0.35

  function update() {
    if (!targets.length) return

    // At the bottom of the document no further scrolling is possible, so the last
    // section can never satisfy the line test on its own. It wins by position instead.
    const atBottom =
      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4
    if (atBottom) {
      setActive(targets[targets.length - 1].id)
      return
    }

    const line = window.innerHeight * LINE
    let current = targets[0]
    for (const el of targets) {
      if (el.getBoundingClientRect().top <= line) current = el
      else break
    }
    setActive(current.id)
  }

  // Scroll fires far more often than the marker can meaningfully change; collapse a
  // burst of events into one read per frame so layout is measured once.
  let queued = false
  function schedule() {
    if (queued) return
    queued = true
    requestAnimationFrame(() => {
      queued = false
      update()
    })
  }

  addEventListener('scroll', schedule, { passive: true })
  addEventListener('resize', schedule)
  update()
</script>

<style>
  .rail {
    position: fixed;
    top: 50%;
    right: 1.75rem;
    transform: translateY(-50%);
    z-index: 5;
  }

  /* No gutter to spare below this width, and the page is short enough that overlaying
     content to navigate it would be a net loss. */
  @media (max-width: 64rem) {
    .rail {
      display: none;
    }
  }

  .rail ul {
    position: relative;
    display: grid;
    gap: 1.15rem;
  }

  /* The connecting line, drawn behind the dots at their center. */
  .rail ul::before {
    content: '';
    position: absolute;
    left: 3.5px;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 1px;
    background: var(--border-strong);
  }

  .rail a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
  }

  .dot {
    position: relative;
    z-index: 1;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--border-strong);
    transition: box-shadow 140ms ease, background 140ms ease;
    flex: none;
  }

  .label {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 140ms ease, transform 140ms ease, color 140ms ease;
  }

  /* Labels stay out of the way until the rail is engaged — hovered, focused, or
     marking the current section. */
  .rail:hover .label,
  .rail:focus-within .label,
  .rail a[aria-current] .label {
    opacity: 1;
    transform: none;
  }

  .rail a:hover .dot,
  .rail a:focus-visible .dot {
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .rail a:hover,
  .rail a:focus-visible {
    color: var(--text-muted);
  }

  .rail a[aria-current] .dot {
    background: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent), 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .rail a[aria-current] {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .dot,
    .label {
      transition: none;
    }
  }
</style>
