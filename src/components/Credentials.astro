---
// ---
// label: Credentials
// role: Education and awards — the short tail of the resume.
// invariants: Both lists come from resume.json. The awards block is omitted entirely
//   when empty rather than rendering a bare heading.
// last-touched: 2026-08-10
// ---
import resume from '../data/resume.json'
import { range, month } from '../lib/format.js'
---

<section class="section" id="education">
  <div class="wrap">
    <div class="section-head">
      <h2>Education &amp; Recognition</h2>
      <span class="rule"></span>
    </div>

    <ul class="rows">
      {
        resume.education.map((e) => (
          <li class="row">
            <div>
              <h3>{e.institution}</h3>
              <p class="detail">
                {e.studyType} {e.area}
              </p>
            </div>
            <p class="mono when">{range(e.startDate, e.endDate)}</p>
          </li>
        ))
      }

      {
        resume.awards.map((a) => (
          <li class="row">
            <div>
              <h3>{a.title}</h3>
              <p class="detail">{a.summary}</p>
            </div>
            <p class="mono when">{month(a.date)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rows {
    display: grid;
    gap: 1.25rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.35rem 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .rows .row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .row h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .detail {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: 0;
  }

  .when {
    margin: 0;
    white-space: nowrap;
  }
</style>
