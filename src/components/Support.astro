---
// ---
// label: Support
// role: Optional donation links for the open-source and write-up work.
// invariants:
//   - Renders NOTHING unless site.json sets support.enabled. The accounts have to exist
//     before the links do — a dead "Sponsor" link is worse than no ask at all, since it
//     reads as abandoned rather than absent.
//   - Framed around work already given away, not around need. The ask lands after the
//     value, never before it.
// last-touched: 2026-08-10
// ---
import site from '../data/site.json'

const { support } = site
---

{
  support.enabled && (
    <section class="section" id="support">
      <div class="wrap">
        <div class="section-head">
          <h2>Support</h2>
          <span class="rule" />
        </div>

        <p class="blurb">{support.blurb}</p>

        <ul class="links">
          {support.links.map((l) => (
            <li>
              <a href={l.url}>
                {l.label}
                {l.note && <span class="note">{l.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .blurb {
    color: var(--text-muted);
    margin-bottom: 1.35rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .links a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    padding: 0.6rem 1rem;
    font-size: 0.9375rem;
    transition: border-color 140ms ease;
  }

  .links a:hover {
    border-color: var(--accent);
  }

  .note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .links a {
      transition: none;
    }
  }
</style>
